JWT_REFRESH_EXPIRES=30d

# OTP and QR
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
SMARTBOARD_QR_EXPIRES_MINUTES=2

# Mail (Node transporter)
MAIL_PROVIDER=node
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20
SMTP_USER=your_email@cmrcet.ac.in
SMTP_PASS=your_smtp_password
SMTP_FROM=CMR Smart Portal <your_email@cmrcet.ac.in>

# Optional when MAIL_PROVIDER=python
PYTHON_BIN=python3
PYTHON_MAIL_SCRIPT=scripts/send_mail.py


