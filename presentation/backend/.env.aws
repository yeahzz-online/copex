NODE_ENV=production
PORT=5000

CORS_ORIGINS=https://your-frontend-domain.com
APP_BASE_URL=https://your-frontend-domain.com

DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=3306
DB_USER=your_rds_user
DB_PASSWORD=your_rds_password
DB_NAME=cmr_smart_portal

JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRES=1h
